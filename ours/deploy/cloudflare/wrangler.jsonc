// OURS: Cloudflare deployment of the app (Worker + one container).
// Secrets are NOT in this file: set them with `pnpm exec wrangler secret put <NAME>`
// (list under "secrets.required" below). Full steps: README.md in this folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidepost-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // app.kanosena.com is the live address. app.steadylamp.com (the address
  // before the rebrand) stays attached and redirects to it, so old links work.
  "routes": [
    { "pattern": "app.kanosena.com", "custom_domain": true },
    { "pattern": "app.steadylamp.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "containers": [
    {
      "class_name": "AppContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "../../.."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppContainer" }]
  },
  "exports": {
    "AppContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  // Passed to the container as environment variables, with the secrets.
  "vars": {
    "NODE_ENV": "production",
    "TZ": "UTC",
    "MAIN_URL": "https://app.kanosena.com",
    "FRONTEND_URL": "https://app.kanosena.com",
    "NEXT_PUBLIC_BACKEND_URL": "https://app.kanosena.com/api",
    "BACKEND_INTERNAL_URL": "http://localhost:3000",
    "REDIS_URL": "redis://localhost:6379",
    "IS_GENERAL": "true",
    "RUN_CRON": "true",
    "TEMPORAL_TLS": "true",
    "STORAGE_PROVIDER": "cloudflare",
    "CLOUDFLARE_BUCKETNAME": "tidepost-media-eu",
    "CLOUDFLARE_REGION": "auto",
    // New uploads use media.kanosena.com. media.steadylamp.com stays attached
    // to the bucket because older posts store links to it.
    "CLOUDFLARE_BUCKET_URL": "https://media.kanosena.com",
    "ENCRYPTION_PROVIDER": "local",
    "DISABLE_REGISTRATION": "true",
    "API_LIMIT": "30",
    // App emails (password resets, activation, notifications) go through
    // Cloudflare Email Sending over SMTP, with upstream's nodemailer provider.
    // kanosena.com is onboarded for sending (records on cf-bounce. and
    // _dmarc.; the iCloud MX/SPF for support@ are untouched). The password is
    // a Cloudflare API token with "Email Sending: Edit", sent as the EMAIL_PASS
    // secret by the deploy workflow from the EMAIL_SMTP_TOKEN repository
    // secret.
    "EMAIL_PROVIDER": "nodemailer",
    "EMAIL_HOST": "smtp.mx.cloudflare.net",
    "EMAIL_PORT": "465",
    "EMAIL_SECURE": "true",
    "EMAIL_USER": "api_token",
    "EMAIL_FROM_ADDRESS": "no-reply@kanosena.com",
    "EMAIL_FROM_NAME": "Kanosena",
    // Demo environment for platform app reviews: the Sandbox channel is on and
    // always labelled. Plans are paid through Stripe's sandbox ("Test
    // payments" on screen, test cards only, no real money). Needs the
    // OURS_STRIPE_* secrets; without them the plan screen falls back to "email
    // us". A live Stripe key would also need OURS_STRIPE_ALLOW_LIVE=true.
    "SANDBOX_CHANNEL_ENABLED": "true",
    "OURS_BILLING_MODE": "stripe",
    // Meta no longer offers Instagram Login to new apps (17/11/2026), so the
    // Instagram (Standalone) channel can't work for us. Instagram goes through
    // a linked Facebook Page instead. See ours/docs/platform-review/meta.md.
    // Our LinkedIn app has only the Community Management API, which LinkedIn
    // won't put next to OpenID Connect, so the personal LinkedIn channel
    // (openid/profile) can't work: we offer LinkedIn Page only. See
    // ours/docs/platform-review/linkedin.md.
    // Everything else we don't offer (and have no developer app for) is hidden
    // too, so the add-channel list shows only Facebook Page, Instagram,
    // LinkedIn Page and the labelled Sandbox (20/11/2026).
    "HIDDEN_PROVIDERS": "instagram-standalone,linkedin,x,reddit,threads,youtube,gmb,tiktok,tiktok-business,pinterest,dribbble,discord,slack,kick,twitch,mastodon,bluesky,lemmy,wrapcast,telegram,nostr,vk,medium,devto,hashnode,wordpress,listmonk,moltbook,whop,skool,mewe,tumblr"
  },
  "secrets": {
    "required": [
      "JWT_SECRET",
      "ENCRYPTION_KEY",
      "DATABASE_URL",
      "TEMPORAL_ADDRESS",
      "TEMPORAL_NAMESPACE",
      "TEMPORAL_API_KEY",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_ACCESS_KEY",
      "CLOUDFLARE_SECRET_ACCESS_KEY"
    ]
  }
}
